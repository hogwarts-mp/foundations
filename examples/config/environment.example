# Inject these values with the dedicated-server service or container runtime.
# Foundations does not automatically load this file.
HMP_MYSQL_URL=mysql://hogwartsmp:CHANGE_ME@127.0.0.1:3306/hogwartsmp
HMP_ADMIN_BOOTSTRAP_SECRET=CHANGE_ME_TO_A_UNIQUE_RANDOM_VALUE
HMP_WEBHOOKS_ENABLED=false
HMP_WEBHOOKS_DISCORD_URL=CHANGE_ME_TO_A_DISCORD_WEBHOOK_URL

# Keep these safe defaults until MafiaHub supplies server-validatable identities.
HMP_ADMIN_REQUIRE_VERIFIED=true
HMP_ADMIN_UNSAFE_ASSERTED_BANS=false
