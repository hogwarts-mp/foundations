{
  "name": "hmp-quidditch",
  "version": "0.9.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Server-authoritative Quidditch built on the HMP Foundations stack.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/foundations.test.js && node test/server.test.js",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "mafiahub": {
    "clientScripts": ["dist/client.js"],
    "serverScripts": ["dist/server.js"],
    "files": ["dist/client.js", "dist/*.html"],
    "exports": ["status", "call", "start", "stop"],
    "resourceDependencies": [
      { "name": "hmp-lib", "version": "0.9.0" },
      { "name": "hmp-core", "version": "0.9.0" },
      { "name": "hmp-activities", "version": "0.9.0" },
      { "name": "hmp-ui", "version": "0.9.0" },
      { "name": "hmp-houses", "version": "0.9.0" },
      { "name": "hmp-inventory", "version": "0.9.0" },
      { "name": "hmp-interact", "version": "0.9.0" },
      { "name": "hmp-audio", "version": "0.9.0" },
      { "name": "hmp-blips", "version": "0.9.0" },
      { "name": "hmp-world", "version": "0.9.0" }
    ],
    "errorBehavior": "stop",
    "priority": -300
  }
}
