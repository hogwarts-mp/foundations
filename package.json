{
  "name": "hogwarts-mp-foundations",
  "version": "0.5.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "resources/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "package": "node scripts/package.mjs",
    "release:check": "node scripts/check-release.mjs",
    "verify": "npm run release:check && npm test && npm run typecheck --workspaces --if-present && npm run build && npm run smoke --workspaces --if-present && npm run package"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.20.6"
  }
}
