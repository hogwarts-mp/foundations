{
  "name": "hmp-emotes",
  "version": "0.4.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Server-curated, synchronized emotes with previews, favorites, and replaceable UI.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx test/emotes.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js",
      "dist/menu.html",
      "dist/emote_assets.json"
    ],
    "exports": ["emotes", "aliases", "favorites", "ui", "status"],
    "resourceDependencies": [
      { "name": "hmp-mysql", "version": "0.4.0" },
      { "name": "hmp-lib", "version": "0.4.0" },
      { "name": "hmp-core", "version": "0.4.0" }
    ],
    "errorBehavior": "stop",
    "priority": -410
  }
}
