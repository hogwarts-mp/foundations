{
  "name": "hmp-loot",
  "version": "0.8.1",
  "private": true,
  "author": "HogwartsMP",
  "description": "Server-placed chests, moonstones and foragables with per-character or shared takes, respawn timers and persistence, replacing the game's own world loot.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline",
    "test": "tsx test/loot.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "exports": [
      "lootables",
      "status"
    ],
    "resourceDependencies": [
      {
        "name": "hmp-mysql",
        "version": "0.8.1"
      },
      {
        "name": "hmp-lib",
        "version": "0.8.1"
      },
      {
        "name": "hmp-core",
        "version": "0.8.1"
      }
    ],
    "errorBehavior": "stop",
    "priority": -412
  }
}
