{
  "name": "hmp-audio",
  "version": "0.4.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Owner-scoped server and client Wwise playback, aliases, and soundbank leases for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx test/audio.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": ["sounds", "catalog", "banks", "status"],
    "resourceDependencies": [
      { "name": "hmp-lib", "version": "0.4.0" }
    ],
    "errorBehavior": "stop",
    "priority": -875
  }
}
