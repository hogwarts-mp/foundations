{
  "name": "hmp-world",
  "version": "0.4.1",
  "private": true,
  "author": "HogwartsMP",
  "description": "Server-wide environment defaults and native world policy for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline && esbuild client/main.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/client.js --legal-comments=inline",
    "test": "tsx test/world.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": ["environment", "policy", "status"],
    "resourceDependencies": [
      { "name": "hmp-lib", "version": "0.4.1" }
    ],
    "errorBehavior": "stop",
    "priority": -420
  }
}
