{
  "name": "hmp-core",
  "version": "0.4.1",
  "private": true,
  "author": "HogwartsMP",
  "description": "Persistent account, identity, character, group and metadata foundations for HogwartsMP servers.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.js --legal-comments=inline && esbuild client/main.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/client.js --legal-comments=inline",
    "test": "tsx test/core.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/main.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": [
      "status",
      "identity",
      "accounts",
      "sessions",
      "characters",
      "groups",
      "metadata"
    ],
    "resourceDependencies": [
      { "name": "hmp-mysql", "version": "0.4.1" },
      { "name": "hmp-lib", "version": "0.4.1" }
    ],
    "errorBehavior": "stop",
    "priority": -800
  }
}
