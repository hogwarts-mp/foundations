{
  "name": "hmp-spells",
  "version": "0.4.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Character-scoped spell entitlements, loadouts, policy rules, and advisory cast events for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx test/spells.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": ["catalog", "policy", "rules", "providers", "grants", "loadouts", "status", "clientStatus", "loadout", "setLoadoutSlot", "cast", "importNativeAssignments"],
    "resourceDependencies": [
      { "name": "hmp-lib", "version": "0.4.0" },
      { "name": "hmp-core", "version": "0.4.0" }
    ],
    "errorBehavior": "stop",
    "priority": -390
  }
}
