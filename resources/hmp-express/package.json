{
  "name": "hmp-express",
  "version": "0.9.1",
  "private": true,
  "author": "HogwartsMP",
  "description": "The Hogwarts Express run from the server on a timetable, with configured stops, dwell times and speeds.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline",
    "test": "tsx test/express.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "exports": [
      "train",
      "status"
    ],
    "resourceDependencies": [
      {
        "name": "hmp-lib",
        "version": "0.9.1"
      }
    ],
    "errorBehavior": "stop",
    "priority": -418
  }
}
