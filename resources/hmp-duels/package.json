{
  "name": "hmp-duels",
  "version": "0.4.1",
  "private": true,
  "author": "HogwartsMP",
  "description": "Consensual, non-lethal wizard duels built on Foundations activities and composable PvP policy.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline && esbuild client/main.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/client.js --legal-comments=inline",
    "test": "tsx test/duels.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": { "esbuild": "0.25.12", "typescript": "5.9.3" },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": ["challenge", "accept", "decline", "cancel", "forfeit", "status"],
    "resourceDependencies": [
      { "name": "hmp-lib", "version": "0.4.1" },
      { "name": "hmp-ui", "version": "0.4.1" },
      { "name": "hmp-core", "version": "0.4.1" },
      { "name": "hmp-activities", "version": "0.4.1" },
      { "name": "hmp-pvp", "version": "0.4.1" }
    ],
    "errorBehavior": "stop",
    "priority": -380
  }
}
