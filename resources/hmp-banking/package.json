{
  "name": "hmp-banking",
  "version": "0.5.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Server-authoritative bank accounts, transfers, cash bridges and an auditable ledger for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline && esbuild client/main.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/client.js --legal-comments=inline",
    "test": "tsx test/banking.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": [
      "accounts",
      "organizations",
      "currencies",
      "transactions",
      "cash",
      "providers",
      "ui",
      "status"
    ],
    "resourceDependencies": [
      { "name": "hmp-mysql", "version": "0.5.0" },
      { "name": "hmp-lib", "version": "0.5.0" },
      { "name": "hmp-core", "version": "0.5.0" },
      { "name": "hmp-inventory", "version": "0.5.0" },
      { "name": "hmp-ui", "version": "0.5.0" }
    ],
    "errorBehavior": "stop",
    "priority": -450
  }
}
