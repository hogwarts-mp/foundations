{
  "name": "hmp-beasts",
  "version": "0.10.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Character-scoped beast bags kept across reconnects and character switches, with released beasts returning to the world.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline",
    "test": "tsx test/beasts.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "exports": [
      "bag",
      "menu",
      "status"
    ],
    "resourceDependencies": [
      {
        "name": "hmp-mysql",
        "version": "0.10.0"
      },
      {
        "name": "hmp-lib",
        "version": "0.10.0"
      },
      {
        "name": "hmp-core",
        "version": "0.10.0"
      },
      {
        "name": "hmp-ui",
        "version": "0.10.0"
      }
    ],
    "errorBehavior": "stop",
    "priority": -411
  }
}
