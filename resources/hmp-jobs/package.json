{
  "name": "hmp-jobs",
  "version": "0.4.1",
  "private": true,
  "author": "HogwartsMP",
  "description": "Persistent employment, grades, duty, permissions, management and payroll for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline && esbuild client/main.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/client.js --legal-comments=inline",
    "test": "tsx test/jobs.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": [
      "jobs",
      "employment",
      "duty",
      "permissions",
      "payroll",
      "ui",
      "audit",
      "status"
    ],
    "resourceDependencies": [
      { "name": "hmp-mysql", "version": "0.4.1" },
      { "name": "hmp-lib", "version": "0.4.1" },
      { "name": "hmp-core", "version": "0.4.1" },
      { "name": "hmp-banking", "version": "0.4.1" },
      { "name": "hmp-ui", "version": "0.4.1" },
      { "name": "hmp-interact", "version": "0.4.1" }
    ],
    "errorBehavior": "stop",
    "priority": -350
  }
}
