{
  "name": "hmp-lib",
  "version": "0.5.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Shared, dependency-free server and client utilities for HogwartsMP resources.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline && esbuild client/main.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/client.js --legal-comments=inline",
    "test": "tsx test/library.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": [
      "text",
      "number",
      "position",
      "validation",
      "rateLimit",
      "locale",
      "logger",
      "input",
      "config",
      "player",
      "command"
    ],
    "errorBehavior": "stop",
    "priority": -900
  }
}
