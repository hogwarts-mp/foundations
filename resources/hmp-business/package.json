{
  "name": "hmp-business",
  "version": "0.3.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Player-run businesses for HogwartsMP: job-owned counters with owner-managed prices, stock, staffing and books on top of hmp-shops, hmp-jobs and hmp-banking.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline",
    "test": "tsx test/business.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "exports": [
      "businesses",
      "shops",
      "offers",
      "stock",
      "books",
      "ui",
      "audit",
      "status"
    ],
    "resourceDependencies": [
      { "name": "hmp-mysql", "version": "0.3.0" },
      { "name": "hmp-lib", "version": "0.3.0" },
      { "name": "hmp-core", "version": "0.3.0" },
      { "name": "hmp-inventory", "version": "0.3.0" },
      { "name": "hmp-ui", "version": "0.3.0" },
      { "name": "hmp-interact", "version": "0.3.0" },
      { "name": "hmp-banking", "version": "0.3.0" },
      { "name": "hmp-shops", "version": "0.3.0" },
      { "name": "hmp-jobs", "version": "0.3.0" }
    ],
    "errorBehavior": "stop",
    "priority": -325
  }
}
