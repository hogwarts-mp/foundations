{
  "name": "hmp-webhooks",
  "version": "0.3.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Server-only queued outbound webhooks and optional event relays for HogwartsMP Foundations.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline",
    "test": "tsx test/webhooks.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "exports": ["send", "status"],
    "resourceDependencies": [
      { "name": "hmp-lib", "version": "0.3.0" }
    ],
    "errorBehavior": "continue",
    "priority": -250
  }
}
